		lineageTag: b1bb2b1f-7d9c-5394-8d11-7ad1bf97908d
		summarizeBy: none
		sourceColumn: Fichier

		annotation SummarizationSetBy = User

	column Dossier
		dataType: string
		lineageTag: 0e8a379a-135c-52de-b2f4-0235d288d70f
		summarizeBy: none
		sourceColumn: Dossier

		annotation SummarizationSetBy = User

	column 'Date du fichier'
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		lineageTag: c8599abe-0b2c-5b6f-bc6f-c584033fadbd
		summarizeBy: none
		sourceColumn: Date du fichier

		annotation SummarizationSetBy = User

	column 'Type de rapport'
		dataType: string
		lineageTag: 9ce25735-cd48-5a2c-a3ec-b744d0e54066
		summarizeBy: none
		sourceColumn: Type de rapport

