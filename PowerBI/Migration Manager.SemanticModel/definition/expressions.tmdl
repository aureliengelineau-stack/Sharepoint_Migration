expression CultureRapports = "fr-FR" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 70b0e286-000e-58fb-a679-6508f20f0408
	queryGroup: Paramètres

	annotation PBI_ResultType = Text

expression Outils =
		let
		    fChamp = (r as record, noms as list) as any =>
		        List.First(
		            List.RemoveNulls(
		                List.Transform(noms, (n) =>
		                    let v = Record.FieldOrDefault(r, n, null)
		                    in if v = null then null else if v is text and Text.Trim(v) = "" then null else v)),
		            null),
		    fTexte = (r as record, noms as list) as nullable text =>
		        let v = fChamp(r, noms) in if v = null then null else Text.Trim(Text.From(v)),
		    fNombreDepuis = (v as any) as nullable number =>
		        if v = null then null
		        else if v is number then v
		        else
		            let
		                t = Text.Remove(Text.From(v), {" ", "#(00A0)", "#(202F)"}),
		                u = Text.Replace(t, ",", ".")
		            in
		                try Number.FromText(u, "en-US") otherwise null,
		    fNombre = (r as record, noms as list) as nullable number => fNombreDepuis(fChamp(r, noms)),
		    fDateHeure = (r as record, noms as list) as nullable datetime =>
		        let v = fTexte(r, noms)
		        in if v = null then null
		           else try DateTime.FromText(v, CultureRapports)
		                otherwise try DateTime.FromText(v, "en-US")
		                otherwise try DateTime.From(DateTimeZone.FromText(v))
		                otherwise null,
		    fDureeSecondes = (r as record, noms as list) as nullable number =>
		        let v = fTexte(r, noms)
		        in if v = null then null
		           else try Duration.TotalSeconds(Duration.FromText(v)) otherwise fNombreDepuis(v),
		    fOctetsDepuisTexte = (v as any) as nullable number =>
		        if v = null then null
		        else if v is number then v
		        else
		            let
		                s = Text.Upper(Text.Trim(Text.From(v))),
		                unites = {{"TB", 1099511627776}, {"GB", 1073741824}, {"MB", 1048576}, {"KB", 1024}, {"TO", 1099511627776}, {"GO", 1073741824}, {"MO", 1048576}, {"KO", 1024}, {"BYTES", 1}, {"OCTETS", 1}, {"B", 1}},
		                trouvee = List.First(List.Select(unites, (u) => Text.EndsWith(s, u{0})), null),
		                nombre = fNombreDepuis(if trouvee = null then s else Text.Trim(Text.Start(s, Text.Length(s) - Text.Length(trouvee{0}))))
		            in
		                if nombre = null then null else nombre * (if trouvee = null then 1 else trouvee{1}),
		    fBooleen = (r as record, noms as list) as nullable logical =>
		        let v = fTexte(r, noms)
		        in if v = null then null else List.Contains({"true", "vrai", "1", "yes", "oui"}, Text.Lower(v)),
		    fContient = (s as text, mots as list) as logical => List.AnyTrue(List.Transform(mots, (m) => Text.Contains(s, m))),
		    fStatut = (statut as nullable text, categorie as nullable text) as text =>
		        let s = Text.Lower((if statut = null then "" else statut) & " " & (if categorie = null then "" else categorie))
		        in if fContient(s, {"fail", "error", "échec", "echec", "erreur"}) then "Échec"
		           else if fContient(s, {"skip", "filter", "ignor", "exclu"}) then "Ignoré / filtré"
		           else if fContient(s, {"migrated", "success", "succeeded", "complete", "migré", "termin"}) then "Migré"
		           else if Text.Trim(s) = "" then "Inconnu"
		           else "Autre",
		    fCleChemin = (t as nullable text) as nullable text =>
		        if t = null or Text.Trim(t) = "" then null
		        else
		            let
		                u = Text.Trim(t),
		                v = if Text.StartsWith(u, "\\?\UNC\") then "\\" & Text.Middle(u, 8)
		                    else if Text.StartsWith(u, "\\?\") then Text.Middle(u, 4)
		                    else u
		            in
		                Text.Lower(Text.TrimEnd(v, {"\", "/"})),
		    fCleUrl = (u as nullable text) as nullable text =>
		        if u = null or Text.Trim(u) = "" then null
		        else
		            let
		                t = Text.Trim(u),
		                chemin = if Text.StartsWith(Text.Lower(t), "http") then "/" & Text.AfterDelimiter(t, "/", 2) else t,
		                decode = Text.Replace(Text.Replace(Text.Replace(chemin, "%20", " "), "%23", "#"), "%25", "%")
		            in
		                Text.Lower(Text.TrimEnd(decode, "/")),
		    fDernierSegment = (u as nullable text) as nullable text =>
		        if u = null or Text.Trim(u) = "" then null
		        else List.Last(Text.SplitAny(Text.TrimEnd(Text.Trim(u), {"/", "\"}), "/\")),
		    fExtension = (ext as nullable text, nom as nullable text) as text =>
		        let
		            e = if ext <> null and Text.Trim(ext) <> "" then ext
		                else if nom <> null and Text.Contains(nom, ".") then Text.AfterDelimiter(nom, ".", {0, RelativePosition.FromEnd})
		                else null
		        in
		            if e = null then "(sans)" else Text.Lower(Text.TrimStart(Text.Trim(e), ".")),
		    fTypeFichier = (ext as nullable text) as text =>
		        let e = if ext = null then "" else Text.Lower(ext)
		        in if List.Contains({"doc", "docx", "docm", "dotx", "odt", "rtf"}, e) then "Word"
		           else if List.Contains({"xls", "xlsx", "xlsm", "xltx", "csv", "ods"}, e) then "Excel / CSV"
		           else if List.Contains({"ppt", "pptx", "potx", "odp"}, e) then "PowerPoint"
		           else if e = "pdf" then "PDF"
		           else if List.Contains({"jpg", "jpeg", "png", "gif", "bmp", "tif", "tiff", "heic"}, e) then "Image"
		           else if List.Contains({"mp4", "mov", "avi", "wmv", "mkv"}, e) then "Vidéo"
		           else if List.Contains({"txt", "md", "eml", "msg", "log"}, e) then "Texte / Mail"
		           else if List.Contains({"zip", "7z", "rar", "bak", "pst", "tmp", "db"}, e) then "Archive / Sauvegarde / Système"
		           else "Autre",
		    fPassageDepuisFichier = (nom as nullable text) as nullable number =>
		        if nom = null then null
		        else try Number.FromText(Text.AfterDelimiter(Text.BeforeDelimiter(nom, ".", {0, RelativePosition.FromEnd}), "_R", {0, RelativePosition.FromEnd}), "en-US") otherwise null
		in
		    [
		        Champ = fChamp,
		        Texte = fTexte,
		        Nombre = fNombre,
		        DateHeure = fDateHeure,
		        DureeSecondes = fDureeSecondes,
		        Booleen = fBooleen,
		        OctetsDepuisTexte = fOctetsDepuisTexte,
		        StatutNormalise = fStatut,
		        CleChemin = fCleChemin,
		        CleUrl = fCleUrl,
		        DernierSegment = fDernierSegment,
		        Extension = fExtension,
		        TypeFichier = fTypeFichier,
		        PassageDepuisFichier = fPassageDepuisFichier
		    ]
	lineageTag: 5d6065d4-3667-57df-8758-611ad4fe9b84
	queryGroup: Fonctions

	annotation PBI_ResultType = Record

expression fnLireCsv =
		(prefixe as text) as table =>
		let
		    Fichiers = Folder.Files(DossierRapports),
		    Filtres = Table.SelectRows(Fichiers, each Text.StartsWith([Name], prefixe, Comparer.OrdinalIgnoreCase) and Text.Lower([Extension]) = ".csv"),
		    LireUn = (contenu as binary, nom as text, dossier as text, date as any) as table =>
		        let
		            Csv = Csv.Document(contenu, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		            Entetes = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
		            Normalises = Table.TransformColumnNames(Entetes, (n) => Text.Lower(Text.Select(n, {"a".."z", "A".."Z", "0".."9"}))),
		            AvecFichier = Table.AddColumn(Normalises, "_fichier", (r) => nom, type text),
		            AvecDossier = Table.AddColumn(AvecFichier, "_dossier", (r) => dossier, type text),
		            AvecDate = Table.AddColumn(AvecDossier, "_date", (r) => date, type nullable datetime)
		        in
		            AvecDate,
		    Tables = List.Transform(Table.ToRecords(Filtres), (f) => LireUn(f[Content], f[Name], f[Folder Path], f[Date modified])),
		    Resultat = if List.IsEmpty(Tables) then #table({"_fichier", "_dossier", "_date"}, {}) else Table.Combine(Tables)
		in
		    Resultat
	lineageTag: daff11f1-25a5-514c-8875-c018d141052b
	queryGroup: Fonctions

	annotation PBI_ResultType = Function

