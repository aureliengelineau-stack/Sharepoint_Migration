	annotation PBI_ResultType = Table

expression stg_Elements =
		let
		    Brut = fnLireCsv("ItemReport"),
		    Lignes = List.Transform(Table.ToRecords(Brut), (r) =>
		        let
		            fichier = Outils[Texte](r, {"_fichier"}),
		            nom = Outils[Texte](r, {"filename", "itemname", "name"}),
		            passage = Outils[Nombre](r, {"incrementalround", "roundnumber"}),
		            passageFichier = Outils[PassageDepuisFichier](fichier)
		        in [
		            Source = Outils[Texte](r, {"source"}),
		            Destination = Outils[Texte](r, {"destination"}),
		            Nom = nom,
		            #"Extension brute" = Outils[Texte](r, {"extension"}),
		            #"Taille (octets)" = Outils[Nombre](r, {"filesize", "itemsize", "filesizebytes", "itemsizebytes", "size"}),
		            #"Type de contenu" = Outils[Texte](r, {"contenttype"}),
		            #"Statut rapport" = Outils[Texte](r, {"status"}),
		            #"Catégorie" = Outils[Texte](r, {"resultcategory"}),
		            Message = Outils[Texte](r, {"message"}),
		            #"ID source" = Outils[Texte](r, {"sourceitemid"}),
		            #"ID destination" = Outils[Texte](r, {"destinationitemid"}),
		            Package = Outils[Texte](r, {"packagenumber"}),
		            #"Job de migration" = Outils[Texte](r, {"migrationjobid"}),
		            Passage = if passage <> null then passage else if passageFichier <> null then passageFichier else 1,
		            #"Task ID" = Outils[Texte](r, {"taskid"}),
		            Poste = Outils[Texte](r, {"devicename"}),
		            #"Fichier rapport" = fichier,
		            #"Dossier rapport" = Outils[Texte](r, {"_dossier"})
		        ]),
		    Typee = Table.FromRecords(Lignes, type table [
		        Source = nullable text, Destination = nullable text, Nom = nullable text, #"Extension brute" = nullable text,
		        #"Taille (octets)" = nullable number, #"Type de contenu" = nullable text, #"Statut rapport" = nullable text,
		        #"Catégorie" = nullable text, Message = nullable text, #"ID source" = nullable text, #"ID destination" = nullable text,
		        Package = nullable text, #"Job de migration" = nullable text, Passage = number, #"Task ID" = nullable text,
		        Poste = nullable text, #"Fichier rapport" = nullable text, #"Dossier rapport" = nullable text]),
		    // rapports de tâche téléchargés plusieurs fois (avant / après relance) : une ligne par tâche, passage et élément
		    Resultat = Table.Distinct(Typee, {"Task ID", "Passage", "Source", "Nom", "Statut rapport"})
		in
		    Resultat
	lineageTag: 399d7c96-ef45-57f3-9113-24ec40928786
	queryGroup: Intermédiaires

