expression stg_Taches =
		let
		    Brut = fnLireCsv("SummaryReport"),
		    Lignes = List.Transform(Table.ToRecords(Brut), (r) =>
		        let passage = Outils[Nombre](r, {"roundnumber", "incrementalround"})
		        in [
		            #"Nom de la tâche" = Outils[Texte](r, {"taskname"}),
		            Source = Outils[Texte](r, {"source", "sourcepath"}),
		            Destination = Outils[Texte](r, {"destination"}),
		            #"Statut rapport" = Outils[Texte](r, {"status"}),
		            #"Octets totaux" = Outils[Nombre](r, {"totalbytes"}),
		            #"Go totaux" = Outils[Nombre](r, {"totalgb"}),
		            #"Nombre de fichiers" = Outils[Nombre](r, {"countoffiles"}),
		            #"Octets migrés" = Outils[Nombre](r, {"migratedbytes"}),
		            #"Go migrés (rapport)" = Outils[Nombre](r, {"migratedgb", "migratedgbincurrentround"}),
		            #"Go non migrés" = Outils[Nombre](r, {"gbnotmigrated", "gbnotmigratedincurrentround"}),
		            #"Éléments analysés" = Outils[Nombre](r, {"totalscanneditems", "totalscanneditem"}),
		            #"Éléments à migrer" = Outils[Nombre](r, {"totaltobemigrateditems", "totaltobemigrated", "totaltobemigratedincurrentround"}),
		            #"Éléments migrés" = Outils[Nombre](r, {"migrateditems", "migrateditemsincurrentround"}),
		            #"Éléments non migrés" = Outils[Nombre](r, {"itemsnotmigrated", "itemsnotmigratedincurrentround"}),
		            Avertissements = Outils[Nombre](r, {"warningcount", "warningcountincurrentround"}),
		            #"Début" = Outils[DateHeure](r, {"starttime"}),
		            Fin = Outils[DateHeure](r, {"endtime"}),
		            #"Durée (s)" = Outils[DureeSecondes](r, {"duration"}),
		            #"Go par heure" = Outils[Nombre](r, {"gbhour"}),
		            Passage = if passage = null then 1 else passage,
		            Agent = Outils[Texte](r, {"agent", "devicename"}),
		            #"Groupe d'agents" = Outils[Texte](r, {"agentgroup"}),
		            #"Raison d'échec" = Outils[Texte](r, {"taskfailurereason"}),
		            #"Task ID" = Outils[Texte](r, {"taskid"}),
		            #"Fichier rapport" = Outils[Texte](r, {"_fichier"}),
		            #"Date du fichier" = Record.FieldOrDefault(r, "_date", null)
		        ]),
		    Typee = Table.FromRecords(Lignes, type table [
		        #"Nom de la tâche" = nullable text, Source = nullable text, Destination = nullable text, #"Statut rapport" = nullable text,
		        #"Octets totaux" = nullable number, #"Go totaux" = nullable number, #"Nombre de fichiers" = nullable number, #"Octets migrés" = nullable number,
		        #"Go migrés (rapport)" = nullable number, #"Go non migrés" = nullable number, #"Éléments analysés" = nullable number,
		        #"Éléments à migrer" = nullable number, #"Éléments migrés" = nullable number, #"Éléments non migrés" = nullable number,
		        Avertissements = nullable number, #"Début" = nullable datetime, Fin = nullable datetime, #"Durée (s)" = nullable number,
		        #"Go par heure" = nullable number, Passage = number, Agent = nullable text, #"Groupe d'agents" = nullable text,
		        #"Raison d'échec" = nullable text, #"Task ID" = nullable text, #"Fichier rapport" = nullable text, #"Date du fichier" = nullable datetime]),
		    // un même Summary report peut être téléchargé plusieurs fois : on garde la version la plus récente de chaque tâche
		    Tries = Table.Buffer(Table.Sort(Typee, {{"Date du fichier", Order.Descending}})),
		    AvecId = Table.Distinct(Table.SelectRows(Tries, each [Task ID] <> null), {"Task ID", "Passage"}),
		    SansId = Table.SelectRows(Tries, each [Task ID] = null),
		    Resultat = Table.RemoveColumns(Table.Combine({AvecId, SansId}), {"Date du fichier"})
		in
		    Resultat
	lineageTag: 0c6dba3b-7140-5eac-9c1b-3dcc8872dee6
