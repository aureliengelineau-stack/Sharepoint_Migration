expression stg_Source =
		let
		    Brut = fnLireCsv("Inventaire_Source"),
		    Lignes = List.Transform(Table.ToRecords(Brut), (r) =>
		        let nom = Outils[Texte](r, {"nom"}), biblio = Outils[Texte](r, {"bibliotheque"}), anomalies = Outils[Texte](r, {"anomalies"})
		        in [
		            #"Chemin complet" = Outils[Texte](r, {"chemincomplet"}),
		            #"Chemin local" = Outils[Texte](r, {"cheminlocal"}),
		            #"Chemin relatif" = Outils[Texte](r, {"cheminrelatif"}),
		            #"Dossier racine" = Outils[Texte](r, {"dossierracine"}),
		            #"Bibliothèque" = if biblio = null then "(non mappé)" else biblio,
		            #"Chemin cible" = Outils[Texte](r, {"chemincible"}),
		            Nom = nom,
		            Extension = Outils[Extension](Outils[Texte](r, {"extension"}), nom),
		            #"Taille (octets)" = Outils[Nombre](r, {"tailleoctets"}),
		            #"Date de création" = Outils[DateHeure](r, {"datecreation"}),
		            #"Date de modification" = Outils[DateHeure](r, {"datemodification"}),
		            #"Caché" = Outils[Booleen](r, {"cache"}),
		            #"Système" = Outils[Booleen](r, {"systeme"}),
		            #"Longueur chemin" = Outils[Nombre](r, {"longueurchemin"}),
		            #"Longueur chemin cible" = Outils[Nombre](r, {"longueurchemincible"}),
		            Profondeur = Outils[Nombre](r, {"profondeur"}),
		            Anomalies = if anomalies = null then "" else anomalies,
		            Hash = Outils[Texte](r, {"hashsha256"})
		        ]),
		    Resultat = Table.FromRecords(Lignes, type table [
		        #"Chemin complet" = nullable text, #"Chemin local" = nullable text, #"Chemin relatif" = nullable text, #"Dossier racine" = nullable text,
		        #"Bibliothèque" = text, #"Chemin cible" = nullable text, Nom = nullable text, Extension = text,
		        #"Taille (octets)" = nullable number, #"Date de création" = nullable datetime, #"Date de modification" = nullable datetime,
		        #"Caché" = nullable logical, #"Système" = nullable logical, #"Longueur chemin" = nullable number,
		        #"Longueur chemin cible" = nullable number, Profondeur = nullable number, Anomalies = text, Hash = nullable text])
		in
		    Resultat
