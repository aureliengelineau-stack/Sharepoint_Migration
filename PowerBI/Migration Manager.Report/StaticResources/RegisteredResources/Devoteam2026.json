            },
            "fontFamily": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#3C3C3A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#3C3C3A"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F7F6"
              }
            },
            "fontFamily": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#E5E4E1"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#E5E4E1"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E5E4E1"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#3C3C3A"
              }
            },
            "fontFamily": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#3C3C3A"
              }
            },
            "fontFamily": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    }
  }
}