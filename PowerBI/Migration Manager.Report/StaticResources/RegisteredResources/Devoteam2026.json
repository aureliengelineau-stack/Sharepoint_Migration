  "neutral": "#FCC354",
  "bad": "#F8485E",
  "maximum": "#F8485E",
  "center": "#FCA2AE",
  "minimum": "#FDDADE",
  "null": "#EFEEEE",
  "hyperlink": "#F8485E",
  "visitedHyperlink": "#F8485E",
  "textClasses": {
    "callout": {
      "fontFace": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "fontSize": 24,
      "color": "#F8485E"
    },
    "title": {
      "fontFace": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "fontSize": 11,
      "color": "#3C3C3A"
    },
    "header": {
      "fontFace": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "fontSize": 12,
      "color": "#3C3C3A"
    },
    "label": {
      "fontFace": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "fontSize": 10,
      "color": "#3C3C3A"
    },
    "largeTitle": {
      "fontFace": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "fontSize": 20,
      "color": "#3C3C3A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E4E1"
              }
            },
            "radius": 15
          }
        ],
        "dropShadow": [
          {
            "show": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#3C3C3A"
              }
            },
            "fontFamily": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#3C3C3A"
              }
            },
            "border": {
              "solid": {
                "color": "#E5E4E1"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#3C3C3A"
              }
            },
            "fontFamily": "Montserrat, Aptos, 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
