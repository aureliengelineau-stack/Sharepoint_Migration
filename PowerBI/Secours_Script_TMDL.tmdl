		measure 'Volume migré (Mo)' = DIVIDE(CALCULATE(SUM('Elements Migration'[Taille (octets)]), 'Elements Migration'[Dernier passage] = TRUE(), 'Elements Migration'[Statut] = "Migré"), 1048576) + 0
