			summarizeBy: none
			sourceColumn: Durée (min)

			annotation SummarizationSetBy = User

		column 'Tâche'
			dataType: string
			lineageTag: a6142aec-0b4b-500d-92ee-75983ec26785
			summarizeBy: none
			sourceColumn: Tâche

			annotation SummarizationSetBy = User

		partition 'Taches Migration' = m
			mode: import
			source =
					let
					    Corr = Table.Buffer(
					        Table.RenameColumns(
					            Table.Distinct(
					                Table.SelectColumns(
					                    Table.SelectRows(
					                        Table.AddColumn(stg_Correspondance, "_cle", each Outils[CleChemin]([Chemin source]), type nullable text),
					                        each [_cle] <> null),
					                    {"_cle", "Bibliothèque"}),
					                {"_cle"}),
					            {{"_cle", "_cleCorr"}, {"Bibliothèque", "_biblioCorr"}})),
					    Base = Table.Buffer(Table.AddColumn(stg_Taches, "_cle", each Outils[CleChemin]([Source]), type nullable text)),
					    Joint = Table.Join(Base, "_cle", Corr, "_cleCorr", JoinKind.LeftOuter),
					    Biblio = Table.AddColumn(Joint, "Bibliothèque", each
					        if [_biblioCorr] <> null then [_biblioCorr]
					        else let s = Outils[DernierSegment]([Destination]) in if s <> null then s else "(inconnue)", type text),
					    Statut = Table.AddColumn(Biblio, "Statut", each
					        let s = Outils[StatutNormalise]([Statut rapport], null)
					        in if s = "Échec" then (if [#"Éléments migrés"] <> null and [#"Éléments migrés"] > 0 then "Terminé avec erreurs" else "Échec")
					           else if s = "Migré" then "Terminé"
					           else s, type text),
					    GoMigres = Table.AddColumn(Statut, "Go migrés", each
					        if [#"Go migrés (rapport)"] <> null then [#"Go migrés (rapport)"]
					        else if [#"Octets migrés"] <> null then [#"Octets migrés"] / 1073741824
					        else null, type nullable number),
					    DureeMin = Table.AddColumn(GoMigres, "Durée (min)", each if [#"Durée (s)"] = null then null else Number.Round([#"Durée (s)"] / 60, 2), type nullable number),
					    Libelle = Table.AddColumn(DureeMin, "Tâche", each
					        if [#"Nom de la tâche"] <> null then [#"Nom de la tâche"]
					        else [#"Bibliothèque"] & " - passage " & Number.ToText([Passage]), type text),
					    Resultat = Table.RemoveColumns(Libelle, {"_cle", "_cleCorr", "_biblioCorr"})
					in
					    Resultat

		annotation PBI_ResultType = Table


