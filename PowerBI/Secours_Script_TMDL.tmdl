		column 'Dernier passage'
			dataType: boolean
			formatString: """VRAI"";""VRAI"";""FAUX"""
			lineageTag: c826e9e0-fd36-54c4-a21f-231dd801c903
			summarizeBy: none
			sourceColumn: Dernier passage

			annotation SummarizationSetBy = User

		partition 'Elements Migration' = m
			mode: import
			source =
					let
					    Taches = Table.Buffer(
					        Table.RenameColumns(
					            Table.Distinct(
					                Table.SelectColumns(Table.SelectRows(#"Taches Migration", each [Task ID] <> null), {"Task ID", "Bibliothèque"}),
					                {"Task ID"}),
					            {{"Task ID", "_tid"}, {"Bibliothèque", "_biblioTache"}})),
					    Src = Table.Buffer(
					        Table.RenameColumns(
					            Table.Distinct(
					                Table.SelectColumns(
					                    Table.SelectRows(
					                        Table.AddColumn(stg_Source, "_cleSrc", each Outils[CleChemin]([Chemin complet]), type nullable text),
					                        each [_cleSrc] <> null),
					                    {"_cleSrc", "Bibliothèque"}),
					                {"_cleSrc"}),
					            {{"Bibliothèque", "_biblioSrc"}})),
					    Base0 = Table.AddColumn(stg_Elements, "Clé source", each Outils[CleChemin]([Source]), type nullable text),
					    Base1 = Table.AddColumn(Base0, "Clé cible", each Outils[CleUrl]([Destination]), type nullable text),
					    J1 = Table.Join(Base1, "Task ID", Taches, "_tid", JoinKind.LeftOuter),
					    J2 = Table.Join(J1, "Clé source", Src, "_cleSrc", JoinKind.LeftOuter),
					    Biblio = Table.AddColumn(J2, "Bibliothèque", each
					        if [_biblioTache] <> null then [_biblioTache] else if [_biblioSrc] <> null then [_biblioSrc] else "(inconnue)", type text),
					    Statut = Table.AddColumn(Biblio, "Statut", each Outils[StatutNormalise]([Statut rapport], [#"Catégorie"]), type text),
					    Ext = Table.AddColumn(Statut, "Extension", each Outils[Extension]([Extension brute], [Nom]), type text),
					    TailleMo = Table.AddColumn(Ext, "Taille (Mo)", each if [#"Taille (octets)"] = null then null else [#"Taille (octets)"] / 1048576, type nullable number),
					    Cle = Table.AddColumn(TailleMo, "Clé élément", each
					        if [#"Clé source"] <> null then [#"Clé source"]
					        else if [#"Clé cible"] <> null then [#"Clé cible"]
					        else Text.Lower(if [Nom] = null then "" else [Nom]), type text),
					    Tampon = Table.Buffer(Table.RemoveColumns(Cle, {"_tid", "_biblioTache", "_cleSrc", "_biblioSrc", "Extension brute"})),
					    MaxParCle = Table.Buffer(
					        Table.RenameColumns(
					            Table.Group(Tampon, {"Clé élément"}, {{"_max", each List.Max([Passage]), type nullable number}}),
					            {{"Clé élément", "_cleMax"}})),
					    J3 = Table.Join(Tampon, "Clé élément", MaxParCle, "_cleMax", JoinKind.LeftOuter),
					    Dernier = Table.AddColumn(J3, "Dernier passage", each [_max] = null or [Passage] >= [_max], type logical),
					    Resultat = Table.RemoveColumns(Dernier, {"_cleMax", "_max"})
					in
					    Resultat

		annotation PBI_ResultType = Table


