		column 'Préparation à la migration'
			dataType: string
			lineageTag: 19a2e1a9-08be-5154-b795-28330392a0c1
			summarizeBy: none
			sourceColumn: Préparation à la migration

			annotation SummarizationSetBy = User

		column 'Task ID'
			dataType: string
			lineageTag: 53a80561-31d9-5654-a828-caceae6eca3b
			summarizeBy: none
			sourceColumn: Task ID

			annotation SummarizationSetBy = User

		column 'Fichier rapport'
			dataType: string
			lineageTag: 09892b8c-ee87-5ade-a288-e539108c02b9
			summarizeBy: none
			sourceColumn: Fichier rapport

			annotation SummarizationSetBy = User

		column 'Bibliothèque'
			dataType: string
			lineageTag: ec7ce082-9b86-557d-848e-0cc972803efd
			summarizeBy: none
			sourceColumn: Bibliothèque

			annotation SummarizationSetBy = User

		column 'État'
			dataType: string
			lineageTag: c10aa5db-fef4-56d4-8218-883577ef34bc
			summarizeBy: none
			sourceColumn: État

			annotation SummarizationSetBy = User

		column 'Taille (Mo)'
			dataType: double
			formatString: #,0.0
			lineageTag: d9541184-5593-5945-94a7-491a03b51b06
			summarizeBy: none
			sourceColumn: Taille (Mo)

			annotation SummarizationSetBy = User

		partition 'Scan Migration Manager' = m
			mode: import
			source =
					let
					    Brut = fnLireCsv("ScanReport"),
					    Lignes = List.Transform(Table.ToRecords(Brut), (r) => [
					        #"Chemin source" = Outils[Texte](r, {"sourcepath", "source"}),
					        #"Statut du scan" = Outils[Texte](r, {"scanstatus", "status"}),
					        #"Taille (octets)" = Outils[OctetsDepuisTexte](Outils[Champ](r, {"datasizebytes", "datasize", "size"})),
					        Fichiers = Outils[Nombre](r, {"filecount"}),
					        Dossiers = Outils[Nombre](r, {"foldercount"}),
					        #"Longueur max. du chemin" = Outils[Nombre](r, {"maxpathlength"}),
					        #"Permissions racine" = Outils[Nombre](r, {"rootpermissions"}),
					        #"Dernier accès" = Outils[DateHeure](r, {"lastaccessed"}),
					        #"Scan créé le" = Outils[DateHeure](r, {"createdon"}),
					        #"Préparation à la migration" = Outils[Texte](r, {"migrationreadiness", "readiness"}),
					        #"Task ID" = Outils[Texte](r, {"taskid"}),
					        #"Fichier rapport" = Outils[Texte](r, {"_fichier"}),
					        #"Date du fichier" = Record.FieldOrDefault(r, "_date", null)
					    ]),
					    Typee = Table.FromRecords(Lignes, type table [
					        #"Chemin source" = nullable text, #"Statut du scan" = nullable text, #"Taille (octets)" = nullable number, Fichiers = nullable number,
					        Dossiers = nullable number, #"Longueur max. du chemin" = nullable number, #"Permissions racine" = nullable number,
					        #"Dernier accès" = nullable datetime, #"Scan créé le" = nullable datetime, #"Préparation à la migration" = nullable text,
					        #"Task ID" = nullable text, #"Fichier rapport" = nullable text, #"Date du fichier" = nullable datetime]),
					    // dernier scan connu pour chaque chemin source
					    Cle = Table.AddColumn(Typee, "_cle", each Outils[CleChemin]([Chemin source]), type nullable text),
					    Tries = Table.Buffer(Table.Sort(Cle, {{"Date du fichier", Order.Descending}, {"Scan créé le", Order.Descending}})),
					    Uniques = Table.Distinct(Tries, {"_cle"}),
					    Corr = Table.Buffer(
					        Table.RenameColumns(
					            Table.Distinct(
					                Table.SelectColumns(
					                    Table.SelectRows(Table.AddColumn(stg_Correspondance, "_k", each Outils[CleChemin]([Chemin source]), type nullable text), each [_k] <> null),
					                    {"_k", "Bibliothèque"}),
					                {"_k"}),
					            {{"Bibliothèque", "_biblio"}})),
					    J = Table.Join(Uniques, "_cle", Corr, "_k", JoinKind.LeftOuter),
					    Biblio = Table.AddColumn(J, "Bibliothèque", each if [_biblio] <> null then [_biblio] else "(inconnue)", type text),
					    Etat = Table.AddColumn(Biblio, "État", each
					        let s = Text.Lower((if [#"Préparation à la migration"] = null then "" else [#"Préparation à la migration"]) & " " & (if [#"Statut du scan"] = null then "" else [#"Statut du scan"]))
					        in if Text.Contains(s, "error") or Text.Contains(s, "fail") or Text.Contains(s, "erreur") or Text.Contains(s, "échec") then "🔴 Erreur"
					           else if Text.Contains(s, "warning") or Text.Contains(s, "avertissement") then "🟠 Avertissement"
					           else if Text.Contains(s, "ready") or Text.Contains(s, "success") or Text.Contains(s, "prêt") then "🟢 Prêt"
					           else "⚪ En cours / inconnu", type text),
					    TailleMo = Table.AddColumn(Etat, "Taille (Mo)", each if [#"Taille (octets)"] = null then null else [#"Taille (octets)"] / 1048576, type nullable number),
					    Resultat = Table.RemoveColumns(TailleMo, {"_cle", "_k", "_biblio", "Date du fichier"})
					in
					    Resultat

		annotation PBI_ResultType = Table


